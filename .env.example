NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
CRON_SECRET=

# 선택: AI 요청 수 제한 (Spec 047). 비워 두면 기본값을 씁니다. 1 이상의 10진 정수(예: 10)만 인정합니다.
# 1e1·0x10·5.0·0·음수 같은 값은 기본값으로 처리하고, 상한(창 86400초, IP별 10000, 전체 100000)을 넘으면 상한을 씁니다.
# 서버 인스턴스마다 메모리에서 따로 셉니다. 전체 한도는 Vercel Firewall 규칙으로 보완하세요.
# 제한 시간 창(초). 기본 600(10분).
AI_RATE_LIMIT_WINDOW_SECONDS=
# /api/reading: IP 하나당 허용 요청 수(기본 6). 한 번 풀이에 요약·상세 2건을 씁니다.
READING_RATE_LIMIT_PER_IP=
# /api/reading: 서버 인스턴스 하나의 전체 허용 요청 수(기본 60).
READING_RATE_LIMIT_GLOBAL=
# /api/consultation: IP 하나당 허용 요청 수(기본 3). 로컬에서 scripts/verify-deep-consultation.ts로 8장을 만들 때는 10 이상으로 올리세요.
CONSULTATION_RATE_LIMIT_PER_IP=
# /api/consultation: 서버 인스턴스 하나의 전체 허용 요청 수(기본 20).
CONSULTATION_RATE_LIMIT_GLOBAL=
